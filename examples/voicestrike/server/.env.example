# Agora credentials — copy from Agora Console
AGORA_APP_ID=your_app_id_here
AGORA_APP_CERTIFICATE=your_app_certificate_here

# Murf API key — required for Murf Falcon TTS (BYOK)
# Generate at: https://murf.ai/api
MURF_API_KEY=your_murf_api_key_here

# Port for the Express server (default: 3001)
PORT=3001

# Public base URL for Agora REST tool calls (required for live game context)
# Agora's cloud servers must be able to reach this URL.
# For local dev: npx cloudflared tunnel --url http://localhost:3001
# Then set this to the generated https://xxx.trycloudflare.com URL.
# If not set, tools are disabled and Striker will not have game context.
TOOL_BASE_URL=

# Secret key embedded in tool endpoint URLs — authorises Agora cloud → server calls.
# Never sent to the browser. Generate with: node -e "console.log(require('crypto').randomUUID())"
# If not set, an ephemeral value is auto-generated and logged at startup (unstable across restarts).
TOOL_SECRET=
